# Copy to .env.local for local development (git-ignored). On Vercel: Project → Settings → Environment Variables.
# NEVER commit real keys: the repo can be read by anyone with access.

# Metro de Lisboa API store (api.metrolisboa.pt). Use ONE of the two options:
#  a) the base64 string after "Authorization: Basic" in the store's curl example
METRO_LISBOA_BASIC_AUTH=
#  b) the application's consumer key and secret
METRO_LISBOA_CONSUMER_KEY=
METRO_LISBOA_CONSUMER_SECRET=
# Optional: only if the store requires the password grant (your API-store login)
METRO_LISBOA_USERNAME=
METRO_LISBOA_PASSWORD=
# The gateway on :8243 may present a certificate that fails verification (their curl example uses -k).
# Set to true only if /live shows "TLS certificate rejected". Affects this one host only.
METRO_LISBOA_INSECURE_TLS=false

# Override feed base URLs if a provider moves an endpoint (see README > Live data).
TML_GO_BASE=https://go.tmlmobilidade.pt/hub/api/v1
# Optional: pin the GO Hub organisation id (else picked from /organizations)
TML_GO_ORGANIZATION=
CARRIS_METROPOLITANA_BASE=https://api.carrismetropolitana.pt/v2
IPMA_BASE=https://api.ipma.pt/open-data

# Trip planner (MOTIS 2). Default: Transitous community instance (non-commercial, light use only).
# For production, run your own MOTIS with the Lisbon feeds and point this at it.
TRIP_PLANNER_URL=https://api.transitous.org
TRIP_PLANNER_USER_AGENT=Mobee/0.1 (pilot; https://github.com/DiogoSolipa/mobee)

# Google OAuth client (Web application). Redirect: <origin>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
